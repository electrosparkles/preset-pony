<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.electrosparkles</groupId>
    <artifactId>preset-pony</artifactId>
    <!--
        Version is read from version.properties at the top of every build via
        properties-maven-plugin (initialize phase). The <version> tag below is a
        placeholder only - it is never used for publishing, only for Maven's own
        internal bookkeeping. The real version flows through:
          - the filtered config/app-version.properties resource (read by AppVersion.java)
          - the jar manifest Implementation-Version
          - the jpackage -app-version argument (linux profile)
        To bump the version: edit version.properties only. No pom change needed.
    -->
    <version>0-PLACEHOLDER</version>
    <packaging>jar</packaging>

    <name>Preset Pony</name>
    <description>Unofficial companion app for Fender Mustang III amplifiers</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <!-- app.version is injected by properties-maven-plugin from version.properties -->
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.hid4java</groupId>
            <artifactId>hid4java</artifactId>
            <version>0.8.0</version>
        </dependency>
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna</artifactId>
            <version>5.19.1</version>
        </dependency>
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna-platform</artifactId>
            <version>5.19.1</version>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- config/ is filtered so ${app.version} is substituted in app-version.properties -->
            <resource>
                <directory>src/main/resources/config</directory>
                <filtering>true</filtering>
                <targetPath>config</targetPath>
            </resource>
            <!-- icons and everything else: no filtering (would corrupt binary PNG files) -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>config/**</exclude>
                </excludes>
            </resource>
        </resources>

        <plugins>

            <!-- 1. Read version.properties so ${app.version} is available to all plugins -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>properties-maven-plugin</artifactId>
                <version>1.2.1</version>
                <executions>
                    <execution>
                        <id>read-version</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>read-project-properties</goal>
                        </goals>
                        <configuration>
                            <files>
                                <file>${project.basedir}/version.properties</file>
                            </files>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 2. Also copy resolved jars into lib/ so Windows scripts can use them without Maven -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>sync-lib</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.basedir}/lib</outputDirectory>
                            <includeScope>runtime</includeScope>
                            <overWriteIfNewer>true</overWriteIfNewer>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 3. Compiler -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <!-- 4. Jar with manifest -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <outputDirectory>${project.basedir}/build/jar</outputDirectory>
                    <finalName>preset-pony</finalName>
                    <archive>
                        <manifest>
                            <mainClass>com.electrosparkles.presetpony.PresetPony</mainClass>
                            <addClasspath>true</addClasspath>
                            <classpathPrefix>../../lib/</classpathPrefix>
                        </manifest>
                        <manifestEntries>
                            <Implementation-Title>Preset Pony</Implementation-Title>
                            <Implementation-Version>${app.version}</Implementation-Version>
                            <Implementation-Vendor>Electrosparkles</Implementation-Vendor>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>

            <!-- 5. Run tests (exec:java on the test suite main method, no JUnit needed) -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>run-tests</id>
                        <phase>test</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.electrosparkles.presetpony.PresetPonyTestSuite</mainClass>
                            <includeProjectDependencies>true</includeProjectDependencies>
                            <!-- Test sources are compiled separately; include them on the classpath -->
                            <additionalClasspathElements>
                                <additionalClasspathElement>${project.build.directory}/test-classes</additionalClasspathElement>
                            </additionalClasspathElements>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

    <!-- Linux jpackage profile: mvn package -Ppackage-linux -->
    <profiles>
        <profile>
            <id>package-linux</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>jpackage-linux</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <!--
                                        Delegates to build-exe.sh so the vboxsf hard-link
                                        workaround and .desktop file generation stay in one place.
                                        build-exe.sh already reads version.properties itself.
                                    -->
                                    <executable>${project.basedir}/build-exe.sh</executable>
                                    <workingDirectory>${project.basedir}</workingDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
